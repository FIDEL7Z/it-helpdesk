PORT=3000
# IANA timezone for management calendar periods and demand hours.
APP_TIMEZONE=America/Fortaleza
MONGODB_URI=mongodb://localhost:27017/it-helpdesk

# Generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Allowed frontend origins (comma-separated)
CORS_ORIGIN=http://localhost:5173

# Demo users created by `npm run seed` (demo only, never real credentials)
SEED_TI_EMAIL=ti@helpdesk.local
SEED_TI_PASSWORD=TiDemo@2026
SEED_SOLICITANTE_EMAIL=solicitante@helpdesk.local
SEED_SOLICITANTE_PASSWORD=Solicitante@2026

# Optional demo IT manager (gestor). Set both or neither.
SEED_GESTOR_EMAIL=gestor@helpdesk.local
SEED_GESTOR_PASSWORD=Gestor@2026

# Explicit opt-in for local demonstration origin controls.
DEMO_MODE=false

# ---------- E-mail notifications (off by default; the helpdesk works without them) ----------
EMAIL_ENABLED=false
# mailpit: local inbox started by docker compose (http://localhost:8025); nothing leaves the machine.
# resend: real delivery; needs RESEND_API_KEY and a sender on a domain verified in Resend.
# gmail: real delivery from one Gmail account; needs GMAIL_USER and GMAIL_APP_PASSWORD.
EMAIL_PROVIDER=mailpit
EMAIL_FROM=IT Helpdesk <helpdesk@helpdesk.local>
# Base of the links in e-mails (the frontend). The pages still require login.
APP_PUBLIC_URL=http://localhost:5173
MAILPIT_URL=http://127.0.0.1:8025
# Never commit a real key. Only used with EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Only used with EMAIL_PROVIDER=gmail: the sending account and its Google app password. Never commit them.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# ---------- Assistant (optional) ----------
# Who answers: demo (no AI, the default), gemini (Google Gemini API, called by this backend) or
# cloudflare (the Worker in ai-worker/). A missing or invalid setting never stops the backend:
# the assistant answers in an identified demonstration mode and says why.
AI_PROVIDER=demo
# Gemini: your own key from Google AI Studio (free tier). Only this backend reads it.
GEMINI_API_KEY=
# Empty uses gemini-3.5-flash-lite.
GEMINI_MODEL=
# Cloudflare: the Worker address and the temporary access key the owner gives you.
AI_WORKER_URL=
AI_WORKER_KEY=
# Outside production, Resend and Gmail only deliver to these addresses or @domains (comma-separated).
EMAIL_RECIPIENT_ALLOWLIST=

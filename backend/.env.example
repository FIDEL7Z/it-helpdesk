PORT=3000
# IANA timezone for management calendar periods and demand hours.
APP_TIMEZONE=America/Fortaleza
MONGODB_URI=mongodb://localhost:27017/it-helpdesk

# Generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Allowed frontend origins (comma-separated)
CORS_ORIGIN=http://localhost:5173

# Demo users created by `npm run seed` (demo only, never real credentials)
SEED_TI_EMAIL=ti@helpdesk.local
SEED_TI_PASSWORD=TiDemo@2026
SEED_SOLICITANTE_EMAIL=solicitante@helpdesk.local
SEED_SOLICITANTE_PASSWORD=Solicitante@2026

# Optional demo IT manager (gestor). Set both or neither.
SEED_GESTOR_EMAIL=gestor@helpdesk.local
SEED_GESTOR_PASSWORD=Gestor@2026

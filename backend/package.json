{
  "name": "it-helpdesk-backend",
  "version": "1.0.0",
  "private": true,
  "description": "IT Helpdesk REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:typecheck": "tsc -p tsconfig.tests.json",
    "test:e2e": "tsx tests/e2e.mjs",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "seed:incidents": "tsx src/scripts/seed-incidents.ts",
    "seed:articles": "tsx src/scripts/seed-articles.ts",
    "seed:scenarios": "tsx src/scripts/seed-scenarios.ts",
    "seed:manager": "tsx src/scripts/seed-manager.ts",
    "seed:inventory": "tsx src/scripts/seed-inventory.ts",
    "docs:capture": "tsx scripts/capture-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
